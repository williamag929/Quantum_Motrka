{
  "name": "motkra-daemon",
  "version": "0.1.0",
  "description": "Motkra system tray daemon — global hotkey mini-chat window",
  "main": "main.js",
  "scripts": {
    "start":     "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac"
  },
  "build": {
    "appId": "com.motkra.daemon",
    "productName": "Motkra Daemon",
    "asar": true,
    "directories": { "output": "dist" },
    "files": [
      "main.js", "tray.js", "ipc.js", "preload.js",
      "chat.html", "assets/**", "email/**"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }],
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "runAfterFinish": true,
      "shortcutName": "Motkra Daemon"
    },
    "extraMetadata": {
      "main": "main.js"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "dotenv": "^16.0.0",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  }
}
