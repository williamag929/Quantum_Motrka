# Copy this file to .env and fill in your values.
# The app loads it automatically on startup.

# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Get your NVIDIA API key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...

# Default mode when no flag is given: auto | local | cloud | kimi
DEFAULT_MODE=auto

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-opus-5-5
# GEMMA_MODEL=gemma4:e2b
# KIMI_MODEL=moonshotai/kimi-k3
# Claude prices in USD per 1M tokens, used for cost and savings figures
# CLAUDE_PRICE_IN=4.0
# CLAUDE_PRICE_OUT=20.0

# Desktop daemon / privacy brain (daemon.py). The Electron app owns 7432 and starts
# `daemon.py --headless` on this port.
# DAEMON_PORT=7433
# DAEMON_HOTKEY=ctrl+shift+space
# Local voice: Whisper size (tiny|base|small|medium), language ("es", "en"; empty = auto)
# VOICE_STT_MODEL=small
# VOICE_LANGUAGE=es
# Piper voice (.onnx). Empty = first voice in ~/.motkra/voices, else the Windows voice.
# Download one:  cd ~/.motkra/voices && python -m piper.download_voices es_MX-claude-high
# PIPER_VOICE=
# VOICE_REPLY=on
